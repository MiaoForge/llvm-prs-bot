{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llvm-prs-bot.invalid/schemas/v1/prs-index.schema.json",
  "title": "PR module index",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "snapshotId": {
      "$ref": "common.schema.json#/$defs/snapshotId"
    },
    "moduleId": {
      "$ref": "common.schema.json#/$defs/moduleId"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "common.schema.json#/$defs/prListFields",
        "unevaluatedProperties": false
      }
    }
  },
  "required": ["schemaVersion", "snapshotId", "moduleId", "items"],
  "additionalProperties": false
}
