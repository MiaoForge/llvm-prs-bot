{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "biome.json",
      "package.json",
      "pipeline/**/*.{mjs,ts,tsx,css,json}",
      "web/**/*.{mjs,ts,tsx,css,json}",
      "!!**/node_modules",
      "!!web/dist",
      "!!web/src/generated",
      "!**/package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
